    "# Save Module Overview DataFrame and Display Summary\n",
    "\n",
    "# Restore original metabolite names in overview before saving\n",
    "if name_lookup:\n",
    "    def restore_metabolite_names(x):\n",
    "        if pd.isna(x) or x == 'NA':\n",
    "            return x\n",
    "        return '|'.join(name_lookup.get(m.strip(), m.strip()) for m in str(x).split('|'))\n",
    "    module_overview['Metabolite_regulators'] = module_overview['Metabolite_regulators'].apply(restore_metabolite_names)\n",
    "    print(f\"Restored original metabolite names using {len(name_lookup)} mappings\")\n",
    "\n",
    "# Merge canonical top_30 MegaGO labels when available\n",
    "if 'megago_label_file' in globals() and os.path.exists(megago_label_file):\n",
    "    megago_labels = pd.read_csv(megago_label_file)\n",
    "    megago_merge_columns = ['Module', 'MegaGO_cluster', 'MegaGO_label']\n",
    "    if 'representative_go_id' in megago_labels.columns:\n",
    "        megago_merge_columns.append('representative_go_id')\n",
    "\n",
    "    megago_labels = megago_labels[megago_merge_columns].copy()\n",
    "    megago_labels['Module'] = megago_labels['Module'].astype(str)\n",
    "    module_overview['Module'] = module_overview['Module'].astype(str)\n",
    "\n",
    "    existing_megago_columns = [\n",
    "        column for column in ['MegaGO_cluster', 'MegaGO_label', 'MegaGO_representative_GO_ID']\n",
    "        if column in module_overview.columns\n",
    "    ]\n",
    "    if existing_megago_columns:\n",
    "        module_overview = module_overview.drop(columns=existing_megago_columns)\n",
    "\n",
    "    module_overview = module_overview.merge(megago_labels, on='Module', how='left')\n",
    "    module_overview = module_overview.rename(columns={'representative_go_id': 'MegaGO_representative_GO_ID'})\n",
    "    print(f\"Merged MegaGO labels for {module_overview['MegaGO_label'].notna().sum()} modules\")\n",
    "else:\n",
    "    print('MegaGO label file not found; exporting overview without MegaGO labels.')\n",
    "\n",
    "# Create output filename with expression info if applicable\n",
    "if prioritize_by_expression:\n",
    "    output_filename = f'Module_Overview_Complete_Expression_{condition1}_vs_{condition2}.csv'\n",
    "    excel_filename = f'Module_Overview_Complete_Expression_{condition1}_vs_{condition2}.xlsx'\n",
    "else:\n",
    "    output_filename = 'Module_Overview_Complete.csv'\n",
    "    excel_filename = 'Module_Overview_Complete.xlsx'\n",
    "\n",
    "# Save to CSV file\n",
    "module_overview.to_csv(output_filename, sep='\\t', index=False)\n",
    "print(f\"Module overview saved to: {output_filename}\")\n",
    "\n",
    "# Save to Excel file\n",
    "module_overview.to_excel(excel_filename, index=False, sheet_name='Module_Overview')\n",
    "print(f\"Module overview saved to: {excel_filename}\")\n",
    "\n",
    "# Display summary statistics\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"MODULE OVERVIEW SUMMARY\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "print(f\"Total modules processed: {len(module_overview)}\")"
   ]
