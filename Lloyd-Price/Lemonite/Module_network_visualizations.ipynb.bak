      "  k= 6: Silhouette= 0.3744, Davies-Bouldin= 0.8760, Calinski-Harabasz=   148.2\n",
      "  k= 7: Silhouette= 0.3610, Davies-Bouldin= 0.8153, Calinski-Harabasz=   160.1\n",
