      "\n",
      "================================================================================\n",
      "SUMMARY OF OPTIMAL CLUSTER COUNTS BY METHOD:\n",
      "\n",
      "top_30:\n",
      "  Silhouette:       k = 3\n",
      "  Davies-Bouldin:   k = 3\n",
