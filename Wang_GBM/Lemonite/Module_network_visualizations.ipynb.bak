    "rrvgo_module_labels_file = os.path.join(top30_output_dir, 'rrvgo_module_labels_top_30.csv')\n",
    "rrvgo_reduced_terms_file = os.path.join(top30_output_dir, 'rrvgo_reduced_terms_top_30.csv')\n",
    "\n",
