/*
========================================================================================
    Test config file
========================================================================================
    Configuration for test data
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function (use with -profile test,singularity)'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 6
    max_memory = '16.GB'
    max_time   = '6.h'

    // Test parameters
    n_clusters = 5
    coherence_threshold = 0.5
    variability_threshold = 0.7
    top_n_genes = 1000

    // MegaGO clustering is slow and not needed to check pipeline function; skip it by
    // default for the smoke test (override with --skip_megago false to exercise it).
    skip_megago = true

    // Input data - use the bundled test dataset
    input_dir = "${projectDir}/test_dataset"
}
